import hmacMiddleware from './middlewares/hmacMiddleware';

app.post(
  '/api/v1/webhook/create-dam-record',
  hmacMiddleware.validate,
  authMiddleware,
  CreateDamRecordController.processWebhook
);

   // Preserve raw body only for Create DAM Record webhook
  app.use(
    '/api/v1/webhook/create-dam-record',
    express.json({
      verify: (req, _res, buffer) => {
        Object.assign(req, {
          rawBody: Buffer.from(buffer),
        });
      },
    })
  );

  // Existing JSON parser for all other APIs
  app.use(express.json());
