catch (error) {
  logger.warn({
    msg: 'Create DAM Record Body JSON parsing failed',
    options: {
      valueLength: value.length,
      isSyntaxError: error instanceof SyntaxError,
      startsWithBrace: value.trim().startsWith('{'),
      endsWithBrace: value.trim().endsWith('}'),
    },
  });

  return null;
}

if (!body) {
  logger.warn({
    msg: 'Create DAM Record request rejected - invalid Body',
    options: {
      bodyType: typeof payload.Body,
      eventIdPresent: payload.EventId !== undefined,
      objectIdPresent: payload.ObjectId !== undefined,
    },
  });

  res.status(400).json({
    message: 'Invalid webhook Body',
  });

  return;
}
