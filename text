declare module 'axios' {
  interface AxiosRequestConfig {
    skipRetry?: boolean;
  }
}

const requestConfig: RetriableRequestConfig = error.config;

// Do not retry non-idempotent operations when explicitly disabled.
if (requestConfig.skipRetry === true) {
  logger.warn({
    msg: 'Aprimo HTTP retry skipped for request',
    options: {
      method: requestConfig.method,
      url: getFullUrl(requestConfig),
      status: error.response?.status,
    },
  });

  return rejectWithError(error);
}

requestConfig.retryAttempt = requestConfig.retryAttempt ?? 0;

const isRetryable = isRetryableHttpError(error);

if (
  requestConfig.retryAttempt >= HTTP_RETRY_COUNT ||
  !isRetryable
) {

const response = await httpClient.post<DamCreateApiResponse>(
