// Log incoming requests before JSON body parsing
app.use((req, _res, next) => {
  logger.info({
    msg: 'Incoming webhook request inspection',
    options: {
      method: req.method,
      path: req.path,
      originalUrl: req.originalUrl,
      contentType: req.get('Content-Type'),
      xSh1Present: Boolean(req.get('X-SH1')),
    },
  });

  next();
});

// Preserve raw body only for Create DAM Record webhook
app.use(
  '/api/v1/webhook/create-dam-record',
  express.json({
    verify: (req, _res, buffer) => {
      Object.assign(req, {
        rawBody: Buffer.from(buffer),
      });

      logger.info({
        msg: 'Create DAM Record raw body captured',
        options: {
          rawBodyLength: buffer.length,
        },
      });
    },
  })
);

// Parse JSON for other APIs
app.use(express.json());
